+# <<< dev_GD
+function Build-SkelOverlay {
+    # $SKW\tags mirrors the live tags tree: every folder OFF the scenario's path is a junction to live (read-only use), the
+    # folders ON the path are real, the scenario's own folder holds real COPIES of its files (no auto-backups, no radiance
+    # bitmaps) and of resources\<leaf>.scenario_*_resource (copied, never junctioned -- without them the tool drops the 16
+    # resource tags), its other subfolders are junctions. The RENAMED scenario <leaf>_sk sits next to it, seeded with the
+    # live lightmap set (the tool keeps the root scalars), so the tool never has a path to save over a live file.
+    $ov = "$SKW\tags"
+    New-Item -ItemType Directory -Force -Path $ov | Out-Null
+    $liveCur = "$RP\tags"; $ovCur = $ov
+    foreach ($next in @($scenRel -split '\\' | Where-Object { $_ })) {
+        if ((Get-Item $ovCur).Attributes -band [IO.FileAttributes]::ReparsePoint) { throw "skeleton overlay: $ovCur must be a REAL directory" }
+        Get-ChildItem $liveCur -Directory | Where-Object { $_.Name -ne $next } | ForEach-Object {
+            $link = Join-Path $ovCur $_.Name
+            if (-not (Test-Path $link)) { New-Item -ItemType Junction -Path $link -Target $_.FullName | Out-Null } }
+        $liveCur = Join-Path $liveCur $next; $ovCur = Join-Path $ovCur $next
+        New-Item -ItemType Directory -Force -Path $ovCur | Out-Null }
+    if ((Get-Item $ovCur).Attributes -band [IO.FileAttributes]::ReparsePoint) { throw "skeleton overlay: $ovCur must be a REAL directory" }
+    Get-ChildItem $tagDirLive -File | Where-Object { $_.Name -notlike '*auto-backup*' -and $_.Name -notlike '*radiance_bitmaps*' } |
+        Copy-Item -Destination $ovCur -Force
+    foreach ($sd in @(Get-ChildItem $tagDirLive -Directory)) {
+        $dst = Join-Path $ovCur $sd.Name
+        if ($sd.Name -eq 'resources') {
+            New-Item -ItemType Directory -Force -Path $dst | Out-Null
+            if ((Get-Item $dst).Attributes -band [IO.FileAttributes]::ReparsePoint) { throw "skeleton overlay: $dst must be a REAL directory" }
+            Get-ChildItem $sd.FullName -File -Filter "$($scenLeaf).scenario_*_resource" | Copy-Item -Destination $dst -Force }
+        elseif (-not (Test-Path $dst)) { New-Item -ItemType Junction -Path $dst -Target $sd.FullName | Out-Null } }
+    # dev_S (2026-10-20): the folder of a BSP that lives OUTSIDE the scenario's folder (01b_spacestation -> 01a_tutorial\01_bsp_1). The off-path
+    # junction above would give the tool a WRITABLE route into LIVE tags through it (a lightmap save into the BSP's folder), so that folder
+    # becomes a REAL overlay folder: file COPIES (the BSP included), its subfolders junctioned for read-only use.
+    $bspDirLive = Split-Path $bspLive
+    if ([IO.Path]::GetFullPath($bspDirLive).TrimEnd('\') -ne [IO.Path]::GetFullPath($tagDirLive).TrimEnd('\')) {
+        $relB = [IO.Path]::GetRelativePath("$RP\tags", $bspDirLive)
+        if ($relB.StartsWith('..') -or [IO.Path]::IsPathRooted($relB)) { throw "skeleton overlay: the BSP folder $bspDirLive is not under $RP\tags" }
+        $liveB = "$RP\tags"; $ovB = $ov
+        foreach ($c in @($relB -split '\\' | Where-Object { $_ })) {
+            $liveB = Join-Path $liveB $c; $nodeOv = Join-Path $ovB $c
+            if ((Test-Path $nodeOv) -and ((Get-Item $nodeOv).Attributes -band [IO.FileAttributes]::ReparsePoint)) { [IO.Directory]::Delete($nodeOv, $false) }   # the LINK only
+            New-Item -ItemType Directory -Force -Path $nodeOv | Out-Null
+            if ((Get-Item $nodeOv).Attributes -band [IO.FileAttributes]::ReparsePoint) { throw "skeleton overlay: $nodeOv must be a REAL directory" }
+            foreach ($sd in @(Get-ChildItem $liveB -Directory)) {
+                $j = Join-Path $nodeOv $sd.Name
+                if (-not (Test-Path $j)) { New-Item -ItemType Junction -Path $j -Target $sd.FullName | Out-Null } }
+            if ($liveB -eq $bspDirLive) {
+                Get-ChildItem $liveB -File | Where-Object { $_.Name -notlike '*auto-backup*' -and $_.Name -notlike '*radiance_bitmaps*' } |
+                    Copy-Item -Destination $nodeOv -Force
+                Write-Host "      skeleton overlay: the BSP's folder $relB is a real overlay folder (file copies), not a junction to live" }
+            $ovB = $nodeOv } }
+    $skName = "$($scenLeaf)_sk"
+    $skDir = Join-Path (Split-Path $ovCur) $skName
