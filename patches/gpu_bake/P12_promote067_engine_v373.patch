+    # v368o first-inner-cell model (A/B only). -NoSkyCellPkt / -NoSkyChain imply it.
+    [switch]$NoSkyCellFull,
+    # v364 the sun's photon-radius candidate cull (0x4A7068 for the sun, flag-0x40 bypass 0x49B1FE). Default ON; -NoSunCull
+    # = the pre-v364 sun (A/B); -RequireSunCull throws when the bypass table cannot be built or fullgpu skips the cull.
+    [switch]$NoSunCull,
+    [switch]$RequireSunCull,
