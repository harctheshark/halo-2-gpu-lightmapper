+    if ($LASTEXITCODE -eq 0) { return [pscustomobject]@{ Cached = $true; Key = $keyF } }
+    if (Test-Path (Join-Path (Split-Path $tagDirLive) "$($scenLeaf)_sk")) {
+        throw "a LIVE folder $($scenLeaf)_sk exists next to the scenario folder -- the overlay would junction it to live; rename it" }
+    $o = Build-SkelOverlay
+    $run = "$SKW\run"
+    New-Item -ItemType Directory -Force -Path $run | Out-Null
+    foreach ($f in 'gpulm.log', 'skel_manifest.bin', 'tool_stdout.txt', 'tool_stderr.txt') {
+        if (Test-Path "$run\$f") { Move-Item "$run\$f" "$run\$f.prev" -Force } }     # this overlay's own logs of the last run
+    $live = Get-GuardSnapshot     # dev_GD: content snapshot (scenario folder + BSP folder + small bake-relevant tag groups)
+    $usedSet = Get-GuardUsedSet   # 0.6.6: the bitmaps / render_models this map uses (the only big tags whose change can stop the bake)
+    $t0 = Get-Date
+    $since = [DateTimeOffset]::new($t0).ToUnixTimeMilliseconds() / 1000.0
+    # The skeleton gets its OWN environment: snapshot every GPULM_* (phases 1-2 set several that phase 3 still needs),
+    # clear them with Remove-Item (Clear-Gpulm; never the .NET setter with $null), set the skeleton set, launch (the
+    # child copies the block at CreateProcess), then restore the snapshot for phase 3.
+    $snap = @{}
+    Get-ChildItem Env: | Where-Object { $_.Name -like 'GPULM_*' } | ForEach-Object { $snap[$_.Name] = $_.Value }
+    try {
+        Clear-Gpulm @($snap.Keys)
+        $env:GPULM_SEVER = "3"; $env:GPULM_ENUM_INST = "1"; $env:GPULM_CHARTPROBE_LATE = "20"
+        $env:GPULM_SKELETON = "1"; $env:GPULM_SKELFILL = "0.5"; $env:GPULM_BASEDIR = "$run\"
+        if ($SceneryOwnPermutationOnly) { $env:GPULM_CHOSEN_PERM_ADD = "1" }     # v373V2: the skeleton builds the lightmap tag's structure -- it must enumerate the same chosen-permutation sections as the capture
+        # RELATIVE to $ROOT (2026-10-07): an absolute overlay -tags_dir overflows a fixed path buffer in the stock tool on
+        # campaign tag paths (0xC0000409 /GS while loading tags -- 07b high_10 CPU reference)
+        $tagsRel = [IO.Path]::GetRelativePath($ROOT, $o.Tags)
+        if ($tagsRel.StartsWith('..') -or [IO.Path]::IsPathRooted($tagsRel)) { throw "skeleton overlay $($o.Tags) is not under $ROOT" }
+        $a = "lightmaps $($o.ScenArg) $Bsp low -tags_dir `"$tagsRel`" -data_dir data -game_root_dir ."
+        if ($osoyOn) {
+            # v370: same command, H2ToolHooks.dll loaded before the first instruction. NOTE its DllMain (attach_to_console) freopens the
+            # process's UCRT stdout/stderr onto CONOUT$ (SetStdHandle): the tool's own output then goes to its console window, so
+            # tool_stdout.txt / tool_stderr.txt stay EMPTY on this run (no script reads them; gpulm.log + skel_manifest.bin are unaffected)
+            # v373V2: with -SceneryOwnPermutationOnly the skeleton DLL is injected while the tool is still HELD (v373M), so process_scenery_object's descriptor hook is in
+            # before the first placement (a 3 s late injection missed placement 0 on a small test map). Without the switch: the unchanged launch + late injection below.
+            if ($SceneryOwnPermutationOnly) { $p = Start-OsoyTool $a "skeleton" $run "$run\tool_stdout.txt" "$run\tool_stderr.txt" -earlyDll $SKDLL -readyLog "$run\gpulm.log" }
+            else { $p = Start-OsoyTool $a "skeleton" $run "$run\tool_stdout.txt" "$run\tool_stderr.txt" }
+        } else {
+        $p = Start-Process -FilePath $TOOL -ArgumentList $a -WorkingDirectory $ROOT -PassThru `
+                -RedirectStandardOutput "$run\tool_stdout.txt" -RedirectStandardError "$run\tool_stderr.txt" @h2lmHide     # H2LM P3
+        $null = $p.Handle     # keeps ExitCode readable after the exit (Start-Process -PassThru)
+        }
+    } finally {
