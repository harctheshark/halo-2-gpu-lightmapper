+    [ValidateRange(1,4)][int]$WriterThreads = 4,
+    # put back a lightmap tag set that lmw_install.py backed up (e.g. $OUT\tag_backup_before_writeback), then exit
+    [string]$RestoreTags = "",
+    [switch]$SkipCapture,
+    [switch]$CaptureOnly,
+    # dev_S (2026-10-20): re-run ONLY the tag writer (skeleton + lm_tagwriter + validation) on an existing -SkipCapture run dir whose atlas_out.bin is
+    # already baked: phases 2 and 3's GPU work are skipped (phase 2 would Guard-clean the atlas). No GPU use. Needs -SkipCapture.
+    [switch]$WriterOnly,
+    # dev_S: run the phase-4 TOOL write-back (the fallback path) inside the skeleton OVERLAY (renamed scenario, own tags tree), never the live tags
+    [switch]$ToolOverlay,
+    # Severance level for the CAPTURE (phase 1) only. Phase 4 always uses 2 -- it needs the rasterize.
+    #   2 = photon cast + r.e. gather + mc_final_gather severed; the CPU rasterize still runs.
+    #   3 = also skips the rasterize's scanline+shading loop (v305). Structure is identical; the
+    #       chart surf88 UVs / V-range are still filled by compute_chart_triangle_scan_bounds.
+    # Default 3: VERIFIED behaviour-preserving on cyclotron against a sever=2 control capture --
+    # soup 25/25 float fields bit-identical over 23855 records; tbuf_sorted an exact permutation
+    # (identical multiset AND multiplicities); inst.bin transform matrices an identical multiset;
+    # bitmaps byte-identical under a self-consistent 5-slot index relabel; the bake itself deposited
+    # the identical 2310091 photons and the identical analytic energy 723.162126 over 855926 texels.
+    # Atlas differs only by float accumulation ORDER: energy ratio 0.999972, pearson 0.99998529.
+    # Capture 94.8s -> 56.0s. Fall back to 2 if the phase-1 placement-link check ever throws.
+    # ***** -SeamCap FORCES sever=2. They are mutually exclusive, by construction:
+    # seam capture retargets the call at 0x4BC70D, which lives inside shade_texel
+    # (0x4BC4AA..0x4BCDC1), which is called at 0x4BBA92 -- inside the 0x4BB88B..0x4BBD84 range that the
+    # v305 sever=3 patch jumps over. on_seam_done also gates on g_curTexel, published at 0x4BC6A0 in
+    # that same skipped loop. So sever=3 cannot produce seam records at any price.
+    # Cost of the trade: phase 1 goes from ~20-37 s to ~95 s. Worth it if the seam tier lands, because
+    # 21.1% of all 20,006,496 shading queries currently fall to the tier-3 own-chart clamp.
+    # The v308 FAITHFUL enclosure gate (validate_texel_sample_visibility 0x4AE08A): 7 hemisphere probes, reject when
+    # the walk did not terminate on a hit OR we hit a BACK face, skip the sample when rejections >= THR.
+    # int_v359: ON by default (every validated bake ran it); -NoGate disables it; -Gate is kept so old command lines work.
+    [switch]$Gate,
+    [switch]$NoGate,
