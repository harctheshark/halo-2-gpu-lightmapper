+    return [pscustomobject]@{ Tags = $ov; SkDir = $skDir; Prefix = $skPfx; ScenArg = $(if ($par) { "$par\$skName\$skName" } else { "$skName\$skName" }) } }
+function Start-Skeleton {
+    New-Item -ItemType Directory -Force -Path $SKW | Out-Null
+    $keyF = "$SKW\skel_key_request.json"
+    & py "$TW\lmw_skeleton.py" key --run-dir $OUT --scenario-dir $tagDirLive --scenario-leaf $scenLeaf --bsp-name $Bsp --dll $SKDLL --tool $TOOL --out $keyF |
+        ForEach-Object { Write-Host "      $_" }
