+    Write-Host ("      skeleton tool run started: pid {0}, injected after {1:n1}s, overlay {2}" -f $p.Id, ((Get-Date) - $t0).TotalSeconds, $o.SkDir)
+    return [pscustomobject]@{ Cached = $false; Key = $keyF; Proc = $p; T0 = $t0; Since = $since; Live = $live; Used = $usedSet; Overlay = $o; Run = $run } }
+function Wait-Skeleton($sk) {
+    if ($null -eq $sk) { throw "the skeleton run was not started (see the phase-3 note)" }
+    if ($sk.Cached) { Write-Host "      skeleton: the cached one for this capture ($OUT\skeleton)"; return }
+    $p = $sk.Proc
+    if (-not $p.HasExited) { Write-Host ("      waiting for the skeleton tool run (pid {0}) ..." -f $p.Id) }
+    if (-not $p.WaitForExit(1800000)) { $p.Kill(); throw "the skeleton tool run was still running after 30 min -- killed" }
+    $p.WaitForExit()
+    $wall = try { ($p.ExitTime - $sk.T0).TotalSeconds } catch { -1 }
+    # isolation proof BEFORE its output is trusted (dev_GD): a bake-relevant content change, a write to this bake's own lightmap tags or a leak out
+    # of the overlay stops the bake (never a silent fallback); a re-save with identical bytes (open Sapien/Guerilla) is ignored, a change to a
+    # tag that does not feed the lightmap (AI, scripts, sounds ...) is a warning. Test-SkeletonIsolation throws on a breach.
