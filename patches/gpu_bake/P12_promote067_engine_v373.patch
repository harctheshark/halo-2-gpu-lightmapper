+    [switch]$SunCullMultiOff,    # GPULM_SUN_CULL_MULTI=0 + GPULM_CULL_MGR_RADIUS=0: the full v372F3 escape
+    [switch]$SunCullForceSkip,   # GPULM_SUN_CULL_FORCE_SKIP=1: the deferred sun pass runs UNCULLED (the F10 gate)
+    [switch]$NoNqFast,           # v372K2: phase 4 with the tool's own NeuQuant (GPULM_NQ_FAST off) -- pre-v372K2, ~4x slower P8 palettes
+    [switch]$NoCastCache,        # v372M: the main pass casts again instead of loading the pre-pass's cast_cache.bin
+    [switch]$SceneryOwnPermutationOnly,   # v373C (2026-10-20, OPT-IN, default OFF; exe label "Scenery Multi Permutation Fix (Experimental Improvement)"): chosen-permutation scenery occluder -- see the v373C note in the header (needs a capture made WITH the switch: scenery_chosen_perm.bin)
+    [switch]$ExactVertexLighting,   # v373E (2026-10-20, opt-in, exe "2004 Exact Vertex Lighting?"): the direct writer re-runs the CPU's 7-probe per-vertex gate (lmw_gate.py) so vertex-lit records drop the samples tool_fast's own write-back drops
+    [switch]$NoVtxAllGate,       # v372K3: phase 1 WITHOUT GPULM_VTXCAP_ALLGATE (the capture's per-vertex gate draws the RNG -> the write-back may ask positions it never saw)
