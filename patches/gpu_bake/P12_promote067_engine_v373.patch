+            "--prefix", $sk.Overlay.Prefix, "--since", "$($sk.Since)", "--scenario-dir", $tagDirLive, "--scenario-leaf", $scenLeaf, "--bsp-name", $Bsp)
+    if ($null -ne $ec) { $ca += @("--tool-exit", "$ec") }
+    & py @ca | ForEach-Object { Write-Host "      $_" }
+    if ($LASTEXITCODE -ne 0) { throw "the skeleton did not verify (lmw_skeleton.py collect exit $LASTEXITCODE; tool exit $ec; logs in $($sk.Run))" }
+    Write-Host ("      skeleton tool run: exit {0}, {1:n1}s, live tags checked ({2} files md5-snapshotted + tree scan)" -f $ec, $wall, $sk.Live.Count) }
+function Invoke-TagWriterStage {
+    # -> the validated stage folder; throws on any failure (the caller falls back to the tool or stops)
+    Wait-Skeleton $script:skel
+    $stage = "$OUT\tagw_stage"
+    # F24 (H2 GPU Lightmapper review finding 24, upstreamed 2026-10-15): the writer's defs_pin gate checks THIS bake's tool ($TOOL =
+    # $ROOT\tool_fast.exe); without --tool it fell back to lmw_tagio's hard-coded H2EKMine path. H2LM_ROOT unset: the same path.
+    $twArgs = @("$TW\lm_tagwriter.py", "--run-dir", $OUT, "--skeleton", "$OUT\skeleton", "--stage", $stage, "--bsp", $bspLive,
