+    $skPfx = "{0}_{1}_lightmap" -f $skName, $Bsp
+    foreach ($sfx in '.scenario_structure_lightmap', '_bitmaps.bitmap', '_truecolor_bitmaps.bitmap') {
+        $src = "$tagDirLive\$ltmpName$sfx"; $dst = "$skDir\$skPfx$sfx"
+        if (Test-Path $src) { Copy-Item $src $dst -Force }
+        elseif (Test-Path $dst) { Move-Item $dst ("{0}.stale_{1:yyyyMMdd_HHmmss}" -f $dst, (Get-Date)) } }   # first bake: no seed
