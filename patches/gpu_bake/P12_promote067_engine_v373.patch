+
+# ---- 1. CAPTURE ------------------------------------------------------------------------------
+if (-not $SkipCapture) {
+    Phase 1 "CAPTURE - CPU loads the map and builds geometry/charts (no lighting)  [sever=$Sever]"
+    New-Item -ItemType Directory -Force -Path $OUT | Out-Null
+    Remove-Item "$OUT\gpulm.log" -ErrorAction SilentlyContinue
