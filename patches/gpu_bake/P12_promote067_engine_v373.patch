+        # the key carries the marker only when ON, so an OFF bake's key -- and the cache it hits -- is unchanged
+        $env:V373_KEYF = $keyF
+        & py -c "import json,os; p=os.environ['V373_KEYF']; k=json.load(open(p)); k['chosen_perm_add']='v373V2-0x499072'; json.dump(k,open(p,'w'),indent=1,sort_keys=True)"
+        $kx2 = $LASTEXITCODE
