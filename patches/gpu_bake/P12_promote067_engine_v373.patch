+              if ($wb.Line -notmatch "prefilled ([1-9]\d*)") {
+                  throw "PHASE 4: the write-back did NOT prefill -- the 866,356 uncovered texels were never marked (-1,-1,-1) and lightmap_pages_finalize would composite uninitialised memory." } }
+    else { throw "PHASE 4: no WRITE-BACK line in $wbLog -- the atlas was NOT injected and the tag now holds severed CPU lighting." }
+    # The splat is as load-bearing as the write-back: without it the tag's per-vertex incident
+    # directions are all the 0.5*normal fallback and the lighting renders flat.
+    # v362: the cluster directions now come from ROOTFILL (chart_dir_splat is off) -- prove it ran.
+    $sp = Select-String -Path $wbLog -Pattern "ROOTFILL: \d+ cluster calls" -ErrorAction SilentlyContinue | Select-Object -Last 1
+    if ($sp) { Write-Host "      $($sp.Line)" }
+    else { throw "PHASE 4: no ROOTFILL summary in $wbLog -- the cluster (BSP) incident directions were NOT refilled." }
+    $ff = Select-String -Path $wbLog -Pattern "FARMFILL: \d+ shared poops" -ErrorAction SilentlyContinue | Select-Object -Last 1
+    if ($ff) { Write-Host "      $($ff.Line)" }
+    # v359 prove the rest: every atlas texel written with 0 bad ordinals over THIS map's chart count, the DLL refused
+    # nothing, and VERTDIR loaded exactly this run's rows (else the flags=1 directions shipped as 0.5*normal).
+    Guard wblog $OUT $wbLog
+    Remove-Item "$OUT\writeback_in_progress.txt" -ErrorAction SilentlyContinue   # v361: proven -- the marker goes
+    Write-Host ("      tool exit={0}" -f $p.ExitCode)
+    Write-Host ("      {0:n1}s" -f $sw.Elapsed.TotalSeconds)
+    $wbToolRan = $true
+}
+# v366 -WriteBackMode both: the Level-2 A/B -- the writer's stage against the set the tool just wrote from the SAME atlas
+if ($WriteBackMode -eq "both" -and $wbToolRan -and $twOk) {
+    Phase "4c" "A/B - the direct writer's stage vs the tool-written live set (same atlas)"
+    & py "$TW\lmw_validate.py" --ab $twStage $tagDirLive --bsp $bspLive --json "$OUT\tagw_ab.json" 2>&1 | ForEach-Object { "      $_" }
+    if ($LASTEXITCODE -ne 0) { Note "tag writer A/B: the stage differs from the tool's tag beyond the declared classes -- see $OUT\tagw_ab.json" }
+    else { Write-Host "      A/B passed: pixels identical, tag differences confined to the declared classes" -ForegroundColor Green } }
+
+Clear-Osoyoos     # v370
+Clear-Gpulm 'GPULM_VTXSCN','GPULM_VTX_STRICT','GPULM_ENUM_SCENERY','GPULM_SCNOBS_DIR','GPULM_NQ_FAST','GPULM_NQ_VERIFY','GPULM_SCN_SELF_PERM','GPULM_SCN_EMBED_FIX','GPULM_CHOSEN_PERM','GPULM_CHOSEN_PERM_ADD','GPULM_SCN_CHOSEN_PERM','GPULM_SCN_HIDDEN_FILL'     # v373H; v371; v373P/v373C (never left behind in the shell); v372K2
+if ($osoyOn) { Write-Host "      v370 Osoyoos fixes ON ($osoyDesc) in every tool run of this bake -- the validated target since 2026-10-08 (the Osoyoos-fixed CPU: high_10 96.97 / mainmenu 96.93 / Needle 96.94 un-floored)" }
+Write-Host ""
+if ($script:Warn.Count) {
+    Write-Host ("NOT THE VALIDATED CONFIGURATION ({0} note(s)):" -f $script:Warn.Count) -ForegroundColor Yellow
+    $script:Warn | ForEach-Object { Write-Host "   - $_" -ForegroundColor Yellow } }
+Write-Host ("TOTAL {0:n1}s ({1:n1} min)   quality={2}   output={3}\atlas_out.bin" -f `
+    $total.Elapsed.TotalSeconds, $total.Elapsed.TotalMinutes, $Quality, $OUT) -ForegroundColor Green
+
+# ***** OPT-IN CLEANUP. This pipeline only writes farm_w{Worker}, which cleanup_farm.ps1 protects, so
+# there is normally nothing here to collect -- but a previous 28-worker CPU reference bake leaves
+# ~73 GB of per-worker capture dumps behind, and -Cleanup sweeps those. Deliberately OPT-IN: a stray
+# farm_wNN may be exactly what someone is mid-way through inspecting, and silently deleting it would
+# be worse than the disk it saves. cpu_ground_truth.ps1 runs the sweep automatically instead, because
+# there the dumps are a guaranteed by-product of the run that just finished.
+if ($Cleanup) { & (Join-Path $WC 'cleanup_farm.ps1') -Active ("farm_w{0:D2}" -f $Worker) }
