-# ***** ⚠⚠⚠ v345 THE ENVIRONMENT-CLEAR TRAP. USE Clear-Gpulm, NEVER SetEnvironmentVariable($v,$null).
-# On PowerShell 7 (measured on 7.6.6) `[Environment]::SetEnvironmentVariable($name,$null)` does NOT
-# delete the variable -- PowerShell binds $null to the String overload as "", so the variable is left
-# SET AND EMPTY. It is worse than a no-op: clearing a variable that was never set CREATES it empty.
-# The DLL has 27 PRESENCE-ONLY checks of the form `if(getenv("GPULM_X"))`, and an empty variable
-# satisfies every one of them, so the script's "clears" were silently ENABLING code paths.
-# MEASURED CONSEQUENCES:
-#   * phase 4 died with `[GPULM v173] GPULM_DUMP_EXIT= -- light tables written, terminating`:
-#     the gate is `if(de && de[0]!='5' && de[0]!='6')`, and an empty string passes it.
-#   * `GPULM_TEXDIRSERVE` is "cleared" before phase 4 yet the log shows
-#     `[GPULM v329] TEXDIR: ...texelpos.bin missing` -- i.e. the REFUTED v329 path was running.
-#     GPULM_SEAM_CAP, GPULM_SEAM_SOUP, GPULM_DIRFILL and GPULM_ENUM_INST are all in the same state.
-# ✅ Flags read via `GetEnvironmentVariableA(..)>0` plus a value test (GPULM_SSDROP, GPULM_CENTROID,
-#    GPULM_CELL_CLAMP, GPULM_GATE, GPULM_RE_KNEAR, ...) are IMMUNE -- the API returns 0 for an empty
-#    variable -- so A/B results measured with those flags are unaffected.
-function Clear-Gpulm { param([string[]]$Names)
-    foreach ($n in $Names) { Remove-Item "Env:$n" -ErrorAction SilentlyContinue } }
-# v371: a leftover shell value of the scenery switches must never reach a tool run they were not set for
-Clear-Gpulm 'GPULM_VTXSCN','GPULM_VTX_STRICT','GPULM_ENUM_SCENERY','GPULM_SCNOBS_DIR','GPULM_SCN_SELF_PERM','GPULM_SCN_EMBED_FIX','GPULM_CHOSEN_PERM','GPULM_CHOSEN_PERM_DIAG','GPULM_CHOSEN_PERM_ADD','GPULM_SCN_CHOSEN_PERM','GPULM_SCN_SUN_EXT','GPULM_SCN_HIDDEN_FILL'   # v373V2 (+ GPULM_CHOSEN_PERM_ADD); v373H; v373P/v373C: a leftover shell value must never reach a run it was not asked for
-# >>> v373D RESPONSIVE MODE (-Responsive, or GPULM_RESPONSIVE=1 inherited): set ONCE here, so every fullgpu run below inherits it. NO Clear-Gpulm call
-# below names GPULM_RESPONSIVE, and the one that clears every GPULM_* for the skeleton run (phase 2b) snapshots and RESTORES it. Any other inherited
-# value is removed (Remove-Item, never SetEnvironmentVariable($null)).
-if ($Responsive -or $env:GPULM_RESPONSIVE -eq '1') {
-    $Responsive = [switch]$true; $env:GPULM_RESPONSIVE = '1'
-    if ($ResponsiveV1) { $env:GPULM_RESPONSIVE_V1 = '1' }
-    if ($ResponsiveDuty -gt 0) { $env:GPULM_RESPONSIVE_DUTY = ([string]$ResponsiveDuty) }
-    Write-Host '*** RESPONSIVE MODE: short GPU submissions, one at a time, with idle gaps between them, lowest GPU priority -- the desktop stays usable; the bake is slower' -ForegroundColor Yellow
-} elseif (Test-Path Env:GPULM_RESPONSIVE) { Clear-Gpulm 'GPULM_RESPONSIVE' }
