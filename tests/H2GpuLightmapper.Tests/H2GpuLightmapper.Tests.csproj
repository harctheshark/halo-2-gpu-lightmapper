<Project Sdk="Microsoft.NET.Sdk">
  <!-- S2.5 + S3.1-S3.4 tests: a console runner (no test packages; builds offline). It references the shell exe project (which
       compiles the whole core in) for the in-process unit tests, and drives the built exe's -cli for the dry-run, end-to-end
       (fake pipeline scripts in a sandbox H2EK, the real portable pwsh + Python bundle + lmw_install) and UI smoke tests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>H2GpuLightmapper.Tests</AssemblyName>
    <RootNamespace>H2GpuLightmapper.Tests</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\H2GpuLightmapper\H2GpuLightmapper.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>
  <ItemGroup>
    <None Include="fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="fixtures\**" />
  </ItemGroup>
</Project>
