<?xml version="1.0" encoding="utf-8"?>
<!-- Offline build: no package sources at all. A restore that needs any package fails (NU1101) instead of downloading. -->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
