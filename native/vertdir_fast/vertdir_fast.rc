// vertdir_fast.exe (0.6.12): the file details and the application manifest of the native per-vertex direction builder
// (vertdir_fast.cpp; /O2 /fp:strict /MT /Brepro and this resource).
#include <winver.h>

1 24 "vertdir_fast.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,6,12,0
 PRODUCTVERSION 0,6,12,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "H2 GPU Lightmapper"
            VALUE "FileDescription", "Native per-vertex light direction builder of the H2 GPU Lightmapper"
            VALUE "FileVersion", "0.6.12.0"
            VALUE "InternalName", "vertdir_fast.exe"
            VALUE "LegalCopyright", "Copyright (c) the H2 GPU Lightmapper project"
            VALUE "OriginalFilename", "vertdir_fast.exe"
            VALUE "ProductName", "H2 GPU Lightmapper"
            VALUE "ProductVersion", "0.6.12.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
