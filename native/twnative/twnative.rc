// tw_native.exe (0.6.9): the file details and the application manifest of the native helper of the tag writer (built from tw_native.cpp
// unchanged; same /O2 /fp:strict flags as the dev build, plus /Brepro and this resource).
#include <winver.h>

1 24 "twnative.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,6,9,0
 PRODUCTVERSION 0,6,9,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "H2 GPU Lightmapper"
            VALUE "FileDescription", "Native helper of the H2 GPU Lightmapper tag writer"
            VALUE "FileVersion", "0.6.9.0"
            VALUE "InternalName", "tw_native.exe"
            VALUE "LegalCopyright", "Copyright (c) the H2 GPU Lightmapper project"
            VALUE "OriginalFilename", "tw_native.exe"
            VALUE "ProductName", "H2 GPU Lightmapper"
            VALUE "ProductVersion", "0.6.9.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
