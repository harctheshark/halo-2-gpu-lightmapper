// H2GpuLightmapper.ToolLoader.exe (0.6.8): the file details and the application manifest of the tool loader built from inject.cpp
// (byte-identical to KEEP\v001-device-probe\inject.cpp: same logic, arguments, exit codes and output text as the inject.exe it replaces).
#include <winver.h>

1 24 "toolloader.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,6,8,0
 PRODUCTVERSION 0,6,8,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "H2 GPU Lightmapper"
            VALUE "FileDescription", "Loads the H2 GPU Lightmapper plug-in into Halo 2's tool"
            VALUE "FileVersion", "0.6.8.0"
            VALUE "InternalName", "H2GpuLightmapper.ToolLoader.exe"
            VALUE "LegalCopyright", "Copyright (c) the H2 GPU Lightmapper project"
            VALUE "OriginalFilename", "H2GpuLightmapper.ToolLoader.exe"
            VALUE "ProductName", "H2 GPU Lightmapper"
            VALUE "ProductVersion", "0.6.8.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
