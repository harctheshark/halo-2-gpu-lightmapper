<Project Sdk="Microsoft.NET.Sdk">
  <!-- S0.4: gpulm_estimator.dll base-path slot patcher + NTFS junction alias. Pure net48 class library, no packages,
       builds offline (NuGet.Config next to this file clears every package source). The shell references this project. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>H2GpuLightmapper.DllSlots</AssemblyName>
    <RootNamespace>H2GpuLightmapper.DllSlots</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
