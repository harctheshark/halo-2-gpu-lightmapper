<Project Sdk="Microsoft.NET.Sdk">
  <!-- S0.4: h2lm-slots.exe, a thin CLI over H2GpuLightmapper.DllSlots for Bash-driven tests (T0/T5) and the Python
       payload builder (layout JSON for MANIFEST.json). The shell itself links the library directly. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>h2lm-slots</AssemblyName>
    <RootNamespace>H2GpuLightmapper.DllSlots.Cli</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\H2GpuLightmapper.DllSlots\H2GpuLightmapper.DllSlots.csproj" />
  </ItemGroup>
</Project>
