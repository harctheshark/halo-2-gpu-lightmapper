<Project Sdk="Microsoft.NET.Sdk">
  <!-- S2.1-S2.4 shell core (net48 library, no packages, builds offline: NuGet.Config here clears every source).
       The source list lives in CoreSources.props so the S2.5 exe can compile the same files in directly (single exe). -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>H2GpuLightmapper.Core</AssemblyName>
    <RootNamespace>H2GpuLightmapper.Core</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <Import Project="CoreSources.props" />
</Project>
